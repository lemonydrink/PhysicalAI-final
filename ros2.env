# Source from bash outside any ML venv/Conda environment.
if [[ -n "${VIRTUAL_ENV:-}" || -n "${CONDA_PREFIX:-}" ]]; then
  echo 'Deactivate the ML environment before loading ROS 2.' >&2
  return 1
fi
_physicalai_ros_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/ros2"
_physicalai_ros_nounset=0
[[ $- == *u* ]] && _physicalai_ros_nounset=1
set +u
_physicalai_ros_hook="$("${PHYSICALAI_PIXI_BIN:-pixi}" shell-hook --manifest-path "$_physicalai_ros_root/pixi.toml" --shell bash)" || return 1
eval "$_physicalai_ros_hook"
export PHYSICALAI_ROS2_ROOT="$_physicalai_ros_root"
if [[ "$_physicalai_ros_nounset" == 1 ]]; then set -u; fi
unset _physicalai_ros_root _physicalai_ros_hook _physicalai_ros_nounset
